  <property name="styleSheet">
   <string>
    * {
        font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', sans-serif;
        outline: none;
    }
    
    QMainWindow, QDialog {
        background-color: #f0f9ff;
    }
    
    QLabel {
        color: #0c4a6e;
        font-size: 14px;
    }
    
    QLabel#pageTitle {
        font-size: 32px;
        font-weight: 800;
        color: #0369a1;
        padding: 10px 0;
        letter-spacing: -1px;
    }
    
    QLabel#sectionTitle {
        font-size: 20px;
        font-weight: 700;
        color: #0284c7;
        margin-top: 10px;
    }
    
    QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit {
        background-color: #ffffff;
        border: 2px solid #e0f2fe;
        border-radius: 12px;
        padding: 10px 15px;
        font-size: 14px;
        color: #0369a1;
        selection-background-color: #7dd3fc;
    }
    
    QLineEdit:hover, QComboBox:hover, QSpinBox:hover {
        border: 2px solid #bae6fd;
    }
    
    QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
        border: 2px solid #0ea5e9;
        background-color: #ffffff;
    }
    
    QPushButton {
        background-color: #0ea5e9;
        color: white;
        border: none;
        border-radius: 12px;
        padding: 12px 24px;
        font-weight: 700;
        font-size: 14px;
    }
    
    QPushButton:hover {
        background-color: #0284c7;
        margin-top: -2px;
        margin-bottom: 2px;
    }
    
    QPushButton:pressed {
        background-color: #0369a1;
        margin-top: 0px;
        margin-bottom: 0px;
    }
    
    QPushButton:disabled {
        background-color: #e0f2fe;
        color: #7dd3fc;
    }
    
    QPushButton#btnAdd {
        background-color: #06b6d4;
    }
    QPushButton#btnAdd:hover {
        background-color: #0891b2;
    }
    
    QPushButton#btnEdit {
        background-color: #38bdf8;
        padding: 8px 16px;
    }
    
    QPushButton#btnDelete {
        background-color: #f43f5e;
        padding: 8px 16px;
    }
    
    QPushButton#btnSecondary {
        background-color: #f0f9ff;
        border: 2px solid #e0f2fe;
        color: #0284c7;
    }
    QPushButton#btnSecondary:hover {
        background-color: #e0f2fe;
        border-color: #bae6fd;
    }

    QWidget#sidebar {
        background-color: #ffffff;
        border-right: 1px solid #e0f2fe;
    }
    
    QLabel#logo {
        color: #0ea5e9;
        font-size: 26px;
        font-weight: 900;
        padding: 40px 20px;
        border: none;
    }
    
    QPushButton#sidebarBtn, QWidget#sidebar QPushButton {
        background-color: transparent;
        color: #64748b;
        text-align: left;
        padding: 14px 24px;
        margin: 4px 16px;
        border-radius: 14px;
        font-size: 15px;
        font-weight: 600;
        border: none;
    }
    
    QPushButton#sidebarBtn:hover, QWidget#sidebar QPushButton:hover {
        background-color: #f0f9ff;
        color: #0ea5e9;
    }
    
    QPushButton#sidebarBtn:checked, QWidget#sidebar QPushButton[active="true"] {
        background-color: #e0f2fe;
        color: #0369a1;
        font-weight: 800;
    }
    
    QPushButton#btnLogout {
        background-color: #fff1f2;
        color: #e11d48;
        margin-top: 20px;
    }
    
    QPushButton#btnLogout:hover {
        background-color: #ffe4e6;
        color: #be123c;
    }
    
    QTableWidget {
        background-color: #ffffff;
        border: 2px solid #e0f2fe;
        border-radius: 16px;
        gridline-color: #f0f9ff;
        selection-background-color: #f0f9ff;
        selection-color: #0369a1;
        outline: none;
    }
    
    QTableWidget::item {
        padding: 16px;
        border-bottom: 1px solid #f0f9ff;
        color: #0c4a6e;
    }
    
    QHeaderView::section {
        background-color: #ffffff;
        color: #64748b;
        padding: 15px;
        border: none;
        border-bottom: 2px solid #e0f2fe;
        font-weight: 800;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    
    QLabel.statCard {
        background-color: #ffffff;
        border: 2px solid #e0f2fe;
        border-radius: 20px;
        padding: 24px;
        font-weight: 700;
    }
    
    QLabel[type="stat-blue"] {
        background-color: #f0f9ff;
        color: #0369a1;
        border: 2px solid #bae6fd;
    }
    QLabel[type="stat-green"] {
        background-color: #f0fdf4;
        color: #166534;
        border: 2px solid #bbf7d0;
    }
    QLabel[type="stat-orange"] {
        background-color: #fff7ed;
        color: #9a3412;
        border: 2px solid #fed7aa;
    }
    QLabel[type="stat-purple"] {
        background-color: #faf5ff;
        color: #581c87;
        border: 2px solid #e9d5ff;
    }

    QScrollBar:vertical {
        border: none;
        background: #f8fafc;
        width: 10px;
        margin: 0;
    }
    QScrollBar::handle:vertical {
        background: #e0f2fe;
        border-radius: 5px;
        min-height: 40px;
    }
    QScrollBar::handle:vertical:hover {
        background: #bae6fd;
    }
   </string>
