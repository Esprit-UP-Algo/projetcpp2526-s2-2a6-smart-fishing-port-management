  <property name="styleSheet">
   <string>
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #f0f4f8, stop:1 #e0eaf5);
}

/* Login Screen Styles */
QDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #f0f4f8, stop:1 #e0eaf5);
}

QWidget#headerContainer {
    background-color: #03224c;
    border-radius: 12px;
}

QLabel#labelTitle {
    color: #03224c;
    font-size: 28px;
    font-weight: bold;
}

QLabel#labelSubtitle {
    color: #e0f0ff;
    font-size: 14px;
}

/* Sidebar */
#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #03224c, stop:1 #0d47a1);
    color: white;
}

#sidebar QLabel {
    color: white;
    font-size: 18px;
    font-weight: bold;
    padding: 20px 0px;
    border-bottom: 3px solid #2196F3;
}

#sidebar QPushButton {
    color: white;
    background-color: #03224c;
    border: none;
    text-align: left;
    padding: 14px 16px;
    font-size: 13px;
    font-weight: 500;
    border-radius: 6px;
    margin: 4px 8px;
}

#sidebar QPushButton:hover {
    background-color: #1565c0;
    border-left: 4px solid #64b5f6;
    padding-left: 12px;
    color: white;
}

#sidebar QPushButton:pressed {
    background-color: #0d47a1;
    color: white;
}

#sidebar QPushButton#btnLogout {
    margin-top: 20px;
}

#sidebar QPushButton#btnLogout:hover {
    background-color: #1565c0;
    color: white;
}

/* Labels */
QLabel {
    color: #1e3a5f;
    font-size: 13px;
    font-weight: 500;
}

/* Input Fields */
QLineEdit {
    background-color: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 10px;
    font-size: 13px;
    color: #1e3a5f;
}

QLineEdit:focus {
    border: 2px solid #03224c;
    background-color: #f0f9ff;
}

QLineEdit::placeholder {
    color: #94a3b8;
}

QComboBox {
    background-color: white;
    border: 2px solid #cbd5e1;
    border-radius: 8px;
    padding: 10px;
    font-size: 13px;
    color: #1e3a5f;
}

QComboBox:focus {
    border: 2px solid #03224c;
    background-color: #f0f9ff;
}

/* Buttons */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #03224c, stop:1 #1e40af);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1e40af, stop:1 #1d4ed8);
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1d4ed8, stop:1 #1e3a8a);
}

QPushButton#btnCancel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #888888, stop:1 #666666);
}

QPushButton#btnCancel:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #666666, stop:1 #555555);
}

QPushButton#btnForgotPassword {
    background: transparent;
    color: #1e3a5f;
    border: none;
    text-decoration: underline;
}

QPushButton#btnForgotPassword:hover {
    color: #03224c;
}

/* Table */
QTableWidget {
    background: white;
    border: 1px solid #e2e8f0;
    gridline-color: #e2e8f0;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #03224c, stop:1 #1e40af);
    color: white;
    padding: 8px;
    border: none;
    font-weight: bold;
    height: 35px;
    width: 180px;
}

QTableWidget::item {
    padding: 6px;
    height: 35px;
    width: 180px;
    color: #1e3a5f;
    background-color: white;
}

QTableWidget::item:hover {
    background-color: #f0f4f8;
}

QTableWidget::item:selected {
    background-color: #dbeafe;
    color: #1e3a5f;
}

/* GroupBox */
QGroupBox { 
    border: 2px solid #03224c; 
    border-radius: 12px; 
    margin-top: 15px; 
    padding-top: 15px; 
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #f8fbff, stop:1 #e8f1ff);
} 

QGroupBox::title { 
    subcontrol-origin: margin; 
    left: 10px; 
    padding: 0 5px 0 5px; 
    color: #03224c; 
    font-weight: bold; 
    font-size: 14px;
}
